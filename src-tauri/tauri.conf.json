{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wavesink",
  "version": "1.0.1",
  "identifier": "us.echo.WaveSink",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WaveSink",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/icons/**",
          "/usr/share/pixmaps/**",
          "/var/lib/flatpak/exports/share/icons/**",
          "$HOME/.local/share/icons/**",
          "$HOME/.local/share/flatpak/exports/share/icons/**",
          "/var/lib/flatpak/app/**/export/share/icons/**",
          "$HOME/.local/share/flatpak/app/**/export/share/icons/**",
          "$HOME/.local/share/Steam/appcache/librarycache/**",
          "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam/appcache/librarycache/**",
          "$HOME/.steam/steam/appcache/librarycache/**",
          "$HOME/snap/steam/common/.local/share/Steam/appcache/librarycache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/linux/wavesink.desktop.hbs",
        "provides": ["sink"],
        "conflicts": ["sink"],
        "replaces": ["sink"],
        "depends": ["libayatana-appindicator3-1", "pipewire-pulse", "wireplumber"],
        "files": {
          "/usr/share/applications/us.echo.WaveSink.desktop": "../packaging/linux/us.echo.WaveSink.desktop"
        }
      },
      "rpm": {
        "desktopTemplate": "../packaging/linux/wavesink.desktop.hbs",
        "provides": ["sink"],
        "conflicts": ["sink"],
        "obsoletes": ["sink"],
        "depends": ["libayatana-appindicator3.so.1()(64bit)", "pipewire-pulseaudio", "wireplumber"],
        "files": {
          "/usr/share/applications/us.echo.WaveSink.desktop": "../packaging/linux/us.echo.WaveSink.desktop"
        }
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
